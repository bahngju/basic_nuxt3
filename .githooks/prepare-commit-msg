#!/bin/bash

# ============================================
# Git Hook: prepare-commit-msg
# --------------------------------------------
# 목적:
# 커밋 메시지 작성 전에 자동 실행되어
# "날짜 (작성자)" 형식을 메시지 상단에 추가
#
# 작성자 이름은 .githooks/.author 파일에서 읽음
# ============================================

# --------------------------------------------
# Git이 전달하는 인자
# $1: 커밋 메시지 파일 경로
# $2: 커밋 생성 방식 (merge, squash 등)
# --------------------------------------------
COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# --------------------------------------------
# 현재 날짜 생성 (YYYY-MM-DD 형식)
# --------------------------------------------
DATE=$(date +"%Y-%m-%d")

# --------------------------------------------
# .author 파일에서 작성자 이름 읽기
# 파일이 없으면 "unknown" 사용
# --------------------------------------------
if [ -f ".githooks/.author" ]; then
  NAME=$(cat .githooks/.author)
else
  NAME="unknown"
fi

# --------------------------------------------
# merge, squash 등 자동 생성 커밋은 제외
# (기존 메시지를 덮어쓰지 않기 위함)
# --------------------------------------------
case "$COMMIT_SOURCE" in
  merge|squash|commit)
    exit 0
    ;;
esac

# --------------------------------------------
# 이미 날짜/작성자 헤더가 존재하면 중복 추가 방지
# --------------------------------------------
if grep -qE "^[0-9]{4}-[0-9]{2}-[0-9]{2} \(.+\)$" "$COMMIT_MSG_FILE"; then
  exit 0
fi

# --------------------------------------------
# 기존 커밋 메시지를 임시 파일에 저장
# (덮어쓰기 전에 백업)
# --------------------------------------------
TMP_FILE="$(mktemp)"
cp "$COMMIT_MSG_FILE" "$TMP_FILE"

# --------------------------------------------
# 새로운 커밋 메시지 구성
# 1. 날짜 + 작성자
# 2. 공백 줄
# 3. 기존 메시지
# --------------------------------------------
{
  echo "$DATE ($NAME)"
  echo ""
  cat "$TMP_FILE"
} > "$COMMIT_MSG_FILE"

# --------------------------------------------
# 임시 파일 삭제
# --------------------------------------------
rm -f "$TMP_FILE"