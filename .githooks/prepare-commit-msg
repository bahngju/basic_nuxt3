#!/bin/bash

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

DATE=$(date +"%Y-%m-%d")
NAME=$(git config user.name)

# user.name이 없으면 기본값
if [ -z "$NAME" ]; then
  NAME="unknown"
fi

# merge commit / squash 등 특수 커밋은 건드리지 않음
case "$COMMIT_SOURCE" in
  merge|squash|commit)
    exit 0
    ;;
esac

# 이미 헤더가 있으면 중복 추가 방지
if grep -qE "^[0-9]{4}-[0-9]{2}-[0-9]{2} \(.+\)$" "$COMMIT_MSG_FILE"; then
  exit 0
fi

TMP_FILE="$(mktemp)"
cp "$COMMIT_MSG_FILE" "$TMP_FILE"

{
  echo "$DATE ($NAME)"
  echo ""
  cat "$TMP_FILE"
} > "$COMMIT_MSG_FILE"

rm -f "$TMP_FILE"